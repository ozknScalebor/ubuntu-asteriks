# =====================================================================
#  Asterisk offline installer - single settings file
#  Read by build-asterisk-deb.sh, collect-packages.sh and install.sh.
# =====================================================================

# ---- Versions --------------------------------------------------------
ASTERISK_VERSION="22.11.0"          # 22.x LTS: full support until 2028-10, security fixes until 2029-10
UBUNTU_CODENAME="noble"             # Ubuntu 24.04 LTS (must match the target machine)
TARGET_PYTHON="3.12"                # python3 version on noble (wheels are downloaded for it)

# Sound packages built into the .deb
SOUND_PACKAGES="CORE-SOUNDS-EN-GSM EXTRA-SOUNDS-EN-WAV MOH-OPSOUND-WAV"

# Prebuilt Digium codec modules added to the .deb
EXTERNAL_CODECS="codec_opus"

# Asterisk modules that must be built AND running for the installation to pass.
# These are the modules used by the files under configs/asterisk/:
#   ODBC realtime : res_odbc res_config_odbc res_sorcery_realtime
#   PJSIP / WSS   : chan_pjsip res_pjsip res_pjsip_session res_pjsip_transport_websocket res_http_websocket
#   Dialplan      : res_pjsip_header_funcs (PJSIP_HEADER) func_groupcount (GROUP) app_dial app_confbridge
#   ARI           : res_ari res_stasis
# If you add a feature to the configuration, add its module here as well.
REQUIRED_MODULES="res_odbc res_config_odbc res_sorcery_realtime chan_pjsip res_pjsip res_pjsip_session res_pjsip_transport_websocket res_http_websocket res_pjsip_header_funcs func_groupcount app_dial app_confbridge res_ari res_stasis"

# ---- Database --------------------------------------------------------
DB_NAME="asterisk"
DB_USER="asterisk"                  # used by ODBC and alembic
DB_PASS="Edsaqw321"

# Remote root access to MySQL from any host.
# "yes" -> 'root'@'%' is created with ROOT_REMOTE_PASS. "no" -> not created.
ROOT_REMOTE="yes"
ROOT_REMOTE_PASS="Edsaqw321"

# Make MySQL listen on all interfaces (bind-address = 0.0.0.0)
MYSQL_BIND_ALL="yes"

# ---- ARI -------------------------------------------------------------
ARI_USER="user"
ARI_PASS="user"
