--- /home/claude/work/s22/configs/samples/extensions.conf.sample	2026-08-27 15:29:40.000000000 +0000
+++ configs/asterisk/extensions.conf	2026-11-12 15:16:30.437246212 +0000
@@ -878,3 +878,30 @@
 ;    same => n,PJSIPNotify(,&Event=Custom&Content-type=application/voicemail&Content=check-messages&Content=)
 ;    same => n,Wait(1)
 ;    same => n,Hangup()
+
+[default]
+exten => _X.,1,NoOp(Default)
+same => n,Dial(PJSIP/${EXTEN})
+
+; Previously Macro(create_conference) / Macro(join_conference).
+; app_macro was removed in Asterisk 21; same flow with Gosub.
+exten => 666,1,Gosub(sub-create_conference,s,1)
+exten => 777,1,Gosub(sub-join_conference,s,1)
+; Joins the fixed conference 1234 (no X-ConfNum header needed).
+exten => 888,1,Gosub(sub-join_conference2,s,1)
+
+[sub-create_conference]
+exten => s,1,Set(__CONFERENCENUM=${PJSIP_HEADER(read,X-ConfNum)})
+same => n,Set(GROUP(conference)=${CONFERENCENUM})
+same => n,ConfBridge(${CONFERENCENUM},my_bridge,my_user)
+same => n,Return()
+
+[sub-join_conference]
+exten => s,1,Set(__CONFERENCENUM=${PJSIP_HEADER(read,X-ConfNum)})
+same => n,ConfBridge(${CONFERENCENUM},my_bridge,my_user)
+same => n,Return()
+
+[sub-join_conference2]
+exten => s,1,Set(__CONFERENCENUM=1234)
+same => n,ConfBridge(1234,my_bridge,my_user)
+same => n,Return()
